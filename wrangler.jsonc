{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yigitserezli-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "CONTACT_FROM_EMAIL": "noreply@yigitserezli.tr",
    "CONTACT_FROM_NAME": "Yiğit Serezli",
    "CONTACT_TO_EMAIL": "devserezli@gmail.com"
  }
  // RESEND_API_KEY is a secret: npx wrangler secret put RESEND_API_KEY
}
