{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yigitserezli-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "yigitserezli.tr", "custom_domain": true },
    { "pattern": "www.yigitserezli.tr", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
